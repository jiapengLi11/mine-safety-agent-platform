[Unit]
Description=MineGuard Agent backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/apps/mineguard
EnvironmentFile=%h/apps/mineguard/mineguard.local.env
ExecStart=%h/dev-middleware/runtime/java/usr/lib/jvm/java-21-openjdk-amd64/bin/java -jar %h/apps/mineguard/app.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
